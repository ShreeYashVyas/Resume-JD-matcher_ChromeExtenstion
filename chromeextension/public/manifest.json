{
  "manifest_version": 3,

  "name": "Resume JD Matcher",
  "version": "1.0",

  "description": "Compare selected Job Description with stored Resume",

   "icons":{
     "16": "icons/icon64.png",
     "32":"icons/icon96.png",
     "48":"icons/icon128.png",
     "128":"icons/icon256.png"
   },

  "action": {
    "default_popup": "index.html",
    "default_title": "Resume Matcher",
    "default_icon":{
     "16": "icons/icon64.png",
     "32":"icons/icon96.png",
     "48":"icons/icon128.png",
     "128":"icons/icon256.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    }
  ]
}